{% doc %}
  Free-shipping progress indicator for the cart drawer.

  Rendered inside snippets/cart-drawer.liquid (.cart-drawer__summary), which
  lives in sections/cart-drawer-section.liquid — the section morphed on every
  cart change by assets/component-cart-items.js. No JS needed here; the Liquid
  re-evaluates on every Section Rendering API response.
{% enddoc %}

{%- liquid
  # Section-scoped override wins when the drawer section opts in. Otherwise
  # fall back to the global cart-group setting so the /cart page and the
  # drawer stay in sync. See Stretch A rationale in README-assignment-1.5.md.
  assign shipping_enabled = settings.coffee_free_shipping_enabled
  assign threshold = settings.coffee_free_shipping_threshold

  if section.settings.coffee_free_shipping_enabled
    assign shipping_enabled = section.settings.coffee_free_shipping_enabled
    assign threshold = section.settings.coffee_free_shipping_threshold
  endif
-%}

{%- if shipping_enabled and threshold > 0 and cart.item_count > 0 -%}
  {%- liquid
    assign threshold_cents = threshold | times: 100
    assign total_cents = cart.total_price
    assign remaining_cents = threshold_cents | minus: total_cents

    if remaining_cents <= 0
      assign unlocked = true
      assign percent = 100
    else
      assign unlocked = false
      assign percent = total_cents | times: 100.0 | divided_by: threshold_cents
    endif

    assign remaining_amount = remaining_cents | money_with_currency
  -%}

  <div
    class="coffee-free-shipping-bar{% if unlocked %} coffee-free-shipping-bar--unlocked{% endif %}"
    role="status"
    aria-live="polite"
  >
    <p class="coffee-free-shipping-bar__message cart-primary-typography">
      {%- if unlocked -%}
        {{ 'content.coffee_free_shipping_unlocked' | t }}
      {%- else -%}
        {{ 'content.coffee_free_shipping_remaining' | t: amount: remaining_amount }}
      {%- endif -%}
    </p>

    <div
      class="coffee-free-shipping-bar__track"
      aria-hidden="true"
    >
      <div
        class="coffee-free-shipping-bar__fill"
        style="inline-size: {{ percent }}%;"
      ></div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .coffee-free-shipping-bar {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
    width: 100%;
    padding-block-end: var(--padding-md);
  }

  .coffee-free-shipping-bar__message {
    margin: 0;
    font-size: var(--font-size--2xs);
    color: var(--color-foreground);
  }

  .coffee-free-shipping-bar--unlocked .coffee-free-shipping-bar__message {
    color: var(--color-success);
    font-weight: var(--font-weight-bold);
  }

  .coffee-free-shipping-bar__track {
    width: 100%;
    height: 6px;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    border-radius: var(--style-border-radius-pills);
    overflow: hidden;
  }

  .coffee-free-shipping-bar__fill {
    display: block;
    block-size: 100%;
    inline-size: 0%;
    max-inline-size: 100%;
    background-color: var(--color-primary-button-background);
    border-radius: var(--style-border-radius-pills);
    transition: inline-size var(--animation-speed) var(--animation-easing);
  }

  .coffee-free-shipping-bar--unlocked .coffee-free-shipping-bar__fill {
    background-color: var(--color-success);
  }

  @media (prefers-reduced-motion: reduce) {
    .coffee-free-shipping-bar__fill {
      transition: none;
    }
  }
{% endstylesheet %}
